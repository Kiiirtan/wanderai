# WanderAI Backend Environment Variables Template
# Copy this file to .env and configure your secret credentials

# Gemini AI (obtain securely from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Database URL
DATABASE_URL=sqlite+aiosqlite:///./travel_planner.db

# JWT Secret (Generate a strong 32-byte secret using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Production/Debug Flag (Set to false in production)
DEBUG=false

# Allowed CORS Origins (Comma-separated list of trusted client origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
